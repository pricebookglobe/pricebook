# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # server-only, never expose to the client

# OpenAI
OPENAI_API_KEY=

# Optional web-search fallback (Serper.dev) — search still works without it,
# it just won't return a reference price when nothing local matches.
WEB_SEARCH_API_KEY=
