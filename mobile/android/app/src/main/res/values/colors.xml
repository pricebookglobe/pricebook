<resources>
    <!-- Brand tokens (mirrors tailwind.config.ts: ink / field / value). -->
    <color name="colorPrimary">#16223F</color>
    <color name="colorPrimaryDark">#0F1830</color>
    <color name="colorAccent">#1F8A5F</color>

    <!-- Shown as the window background the instant the process starts,
         before Capacitor's own JS-driven splash (capacitor.config.ts,
         SplashScreen plugin) can take over — now the brand's light green
         (tailwind value-soft, #DCEEE3), matching the full-screen
         splash.png images so there's no color jump between the two, and
         still light enough that the navy shield outline reads clearly on
         it (navy-on-navy was the original "not clear" complaint). -->
    <color name="splashBackground">#DCEEE3</color>
</resources>
