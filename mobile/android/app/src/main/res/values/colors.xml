<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Brand tokens (mirrors tailwind.config.ts: ink / field / value). -->
    <color name="colorPrimary">#16223F</color>
    <color name="colorPrimaryDark">#0F1830</color>
    <color name="colorAccent">#1F8A5F</color>

    <!-- Shown as the window background the instant the process starts,
         before Capacitor's own JS-driven splash (capacitor.config.ts,
         SplashScreen plugin) can take over. White, not navy: the logo's
         shield outline and "P" are navy, so on a navy background they
         were nearly invisible (only the green bits showed) no matter how
         big or sharp the icon was — this is what was actually reported as
         "not clear". White is a brief (well under a second) background
         before the branded navy splash.png takes over, not a mismatch. -->
    <color name="splashBackground">#FFFFFF</color>
</resources>
