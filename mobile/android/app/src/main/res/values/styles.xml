<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <!-- The Android 12+ SplashScreen API (backported pre-31 by
         androidx.core:core-splashscreen, see MainActivity) only recognizes
         its own windowSplashScreen* attributes — a plain android:background
         is silently ignored by Theme.SplashScreen, which is why this was
         showing a blank/white screen at launch instead of @drawable/splash.
         This shows our navy background + the shield mark immediately at
         cold start; postSplashScreenTheme then hands off to the normal app
         theme once onCreate runs, and Capacitor's own SplashScreen plugin
         (capacitor.config.ts) takes it from there with the full branded
         splash.png for up to 3s while the site loads.

         windowSplashScreenAnimatedIcon is @drawable/splash_icon, not
         @mipmap/ic_launcher_foreground: the launcher art's navy shield
         outline and navy "P" are drawn to sit on the adaptive icon's light
         background, so placed directly on this navy splashBackground they
         all but disappeared, leaving only the green bits visible (this is
         what the screenshot showed). splash_icon.png is the same mark on
         its own small cream card — matching splash.png's card treatment —
         so it has real contrast regardless of what's behind it. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splashBackground</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>