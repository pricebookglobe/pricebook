# Copy this file to keystore.properties (same folder) and fill in the real
# values — keystore.properties itself is gitignored and must never be
# committed, since it holds the password that protects this app's signing
# key. Losing that key means Google Play can never accept an update to this
# app again under the same listing; losing the password is just as bad if
# there's no backup of it anywhere.
#
# storeFile is relative to the mobile/android/ directory (the project root
# this file is read from), e.g. "app/pricebook-upload-key.jks" if the
# keystore lives right next to this file.
storeFile=app/pricebook-upload-key.jks
storePassword=
keyAlias=pricebook
keyPassword=
